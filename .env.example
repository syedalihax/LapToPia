# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB Atlas cluster (MERN backend)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/laptopia?retryWrites=true&w=majority"

# CLOUDINARY: Cloud image storage credentials (Optional)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ADMIN: Secret key for admin console operations
ADMIN_SECRET_KEY="laptopia2025"

# WHATSAPP: Support concierge number (Pakistani format)
VITE_WHATSAPP_NUMBER="923000000000"
